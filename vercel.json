{
  "functions": {
    "api/noticias.js": {
      "maxDuration": 60
    },
    "api/ingesta.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/compartir",
      "destination": "/api/compartir"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-cache"
        },
        {
          "key": "service-worker-allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "content-type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
